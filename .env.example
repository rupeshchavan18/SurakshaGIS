# ==============================================================================
# SurakshaGIS - Environment Configuration Template
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - Only client-safe variables prefixed with VITE_ are accessible to the browser.
# - Use the Supabase ANON PUBLIC KEY only.
# - NEVER put your Supabase SERVICE_ROLE KEY or database postgres password here.
# - Copy this file to .env: `cp .env.example .env`
# ==============================================================================

# Supabase Project URL (From Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Public API Key (Client-side safe key with RLS enforcement)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-here

# Optional: Path to Indian Flood Risk CSV dataset (defaults to /docs/flood_risk_dataset_india.csv)
VITE_CSV_DATASET_PATH=/docs/flood_risk_dataset_india.csv
